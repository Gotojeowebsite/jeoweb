---
interface Props {
	size?: number;
	withWordmark?: boolean;
	href?: string;
}
const { size = 32, withWordmark = true, href = '/' } = Astro.props;
---
<a class="logo" href={href} aria-label="Jeo home">
	<svg
		class="logo-mark"
		width={size}
		height={size}
		viewBox="0 0 32 32"
		aria-hidden="true"
	>
		<defs>
			<linearGradient id="logo-grad" x1="0%" y1="0%" x2="100%" y2="100%">
				<stop offset="0%" stop-color="var(--brand-400)" />
				<stop offset="100%" stop-color="var(--brand-600)" />
			</linearGradient>
		</defs>
		<rect x="2" y="2" width="28" height="28" rx="7" fill="url(#logo-grad)" />
		<path
			fill="#fff"
			d="M20 7.5a1.75 1.75 0 0 1 3.5 0v12.25a6.75 6.75 0 0 1-6.75 6.75h-0.5a6.75 6.75 0 0 1-6.75-6.75 1.75 1.75 0 0 1 3.5 0 3.25 3.25 0 0 0 3.25 3.25h0.5a3.25 3.25 0 0 0 3.25-3.25V7.5Z"
		/>
	</svg>
	{withWordmark && <span class="logo-text">jeo</span>}
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--fg-0);
		text-decoration: none;
		font-family: var(--font-display);
		font-size: 1.375rem;
		font-weight: var(--weight-display);
		letter-spacing: -0.04em;
	}
	.logo:hover { opacity: 0.9; }
	.logo-mark { flex-shrink: 0; border-radius: 7px; }
	.logo-text { line-height: 1; }

	/* Premium FX restores the rotate-on-hover flourish. */
	:global([data-fx='premium']) .logo-mark {
		transition: transform var(--motion-fast) var(--ease-out-soft);
	}
	:global([data-fx='premium']) .logo:hover .logo-mark {
		transform: rotate(-6deg);
	}
</style>
