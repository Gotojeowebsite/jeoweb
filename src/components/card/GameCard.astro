---
import Icon from '../Icon.astro';
import { gameSlug, gameTypeLabel, type Game } from '../../lib/catalog';

interface Props {
	game: Game;
	priority?: boolean;
	compact?: boolean;
}
const { game, priority = false, compact = false } = Astro.props;
const slug = gameSlug(game);
const typeIcon: 'zap' | 'gamepad' | 'sparkles' =
	game.type === 'flash' ? 'zap' : game.type === 'retro' ? 'gamepad' : 'sparkles';
const displayName = game.displayName ?? game.name;
const difficultyLabel: Record<'easy' | 'med' | 'hard', string> = {
	easy: 'Easy', med: 'Medium', hard: 'Tough',
};
const durationLabel = game.durationMin
	? game.durationMin[0] === game.durationMin[1]
		? `≈${game.durationMin[0]} min`
		: `≈${game.durationMin[0]}-${game.durationMin[1]} min`
	: null;
// Phase-2 triple-confirm verdicts:
//   broken / maintenance  -> hide-by-default + grayscale ribbon
//   probable_broken       -> live in catalog, soft warn ribbon
//   unverified / unknown  -> live in catalog, no ribbon
//   healthy               -> default state
const isBroken = game.status === 'broken' || game.status === 'maintenance';
const isProbable = game.status === 'probable_broken';
const isUnverified = game.status === 'unverified';
const variantClass = isBroken ? 'card--broken'
	: isProbable ? 'card--probable'
	: isUnverified ? 'card--unverified'
	: undefined;
const ribbon = isBroken
	? (game.status === 'maintenance' ? 'Maintenance' : 'Broken')
	: isProbable ? 'Probably broken'
	: null;
---
<a
	class:list={['card', 'fx-tilt', 'fx-ripple', { 'card--compact': compact }, variantClass]}
	href={`/play/${slug}`}
	data-slug={slug}
	data-name={game.name}
	data-display-name={displayName}
	data-type={game.type}
	data-status={game.status ?? 'healthy'}
	data-tags={(game.tags ?? []).join('|')}
	data-difficulty={game.difficulty ?? ''}
	data-duration-min={game.durationMin?.[0] ?? ''}
	data-duration-max={game.durationMin?.[1] ?? ''}
>
	<div class="card-cover">
		{game.image ? (
			<picture>
				{/* convert-covers-to-webp.mjs writes <stem>.webp siblings for
				    every catalog cover that wasn't already WebP/SVG. The img
				    fallback covers older browsers and the handful of covers
				    where the WebP write was skipped. */}
				{!game.image.match(/\.(webp|svg|ico|gif)$/i) && (
					<source srcset={`/${game.image.replace(/\.[^.]+$/, '.webp')}`} type="image/webp" />
				)}
				<img
					src={`/${game.image}`}
					alt=""
					loading={priority ? 'eager' : 'lazy'}
					decoding={priority ? 'sync' : 'async'}
					width="400"
					height="225"
				/>
			</picture>
		) : (
			<div class="card-cover-empty" aria-hidden="true">
				<Icon name="gamepad" size={36} />
			</div>
		)}
		<span class:list={['card-type', `card-type--${game.type}`]} title={gameTypeLabel(game.type)}>
			<Icon name={typeIcon} size={12} />
		</span>
		<button
			class="card-fav"
			type="button"
			aria-label={`Favorite ${game.name}`}
			data-fav-toggle={slug}
		>
			<Icon name="heart" size={16} />
		</button>
		{ribbon && (
			<div class="card-broken-ribbon">
				<Icon name="shield" size={12} />
				<span>{ribbon}</span>
			</div>
		)}
	</div>
	<div class="card-meta">
		<div class="card-title">{displayName}</div>
		{!compact && (
			<div class="card-sub">
				{game.difficulty && (
					<span class:list={['card-chip', `card-chip--diff-${game.difficulty}`]}>
						{difficultyLabel[game.difficulty]}
					</span>
				)}
				{durationLabel && <span class="card-chip card-chip--time">{durationLabel}</span>}
				{!game.difficulty && !durationLabel && game.tags?.length ? (
					<span class="card-chip card-chip--ghost">{game.tags.slice(0, 2).join(' · ')}</span>
				) : null}
			</div>
		)}
	</div>
</a>

<!--
	Card styles are intentionally GLOBAL: grid-runtime.ts materializes
	cards at runtime (no data-astro-cid attribute on those nodes), and
	we need the SSR and runtime cards to look identical. Class names
	used here are namespaced enough (card, card-cover, card-fav, …)
	to not collide with anything else in the codebase.
-->
<style is:global>
	.card {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		color: var(--fg-0);
		text-decoration: none;
		isolation: isolate;
		border-radius: var(--radius-lg);
		/* Transform is owned by .fx-tilt utility — don't double-apply here. */
	}
	.card:hover { color: var(--fg-0); }
	/* Override the reset's tiny outline — focus glows the cover, which has
	   the real visual boundary the user is targeting. Also pause the tilt
	   so the ring stays axis-aligned (rotated outlines look broken). */
	.card:focus-visible { outline: none; }
	.card:focus-visible .card-cover {
		border-color: var(--accent);
		box-shadow: 0 0 0 2px var(--bg-0), 0 0 0 4px var(--accent), var(--shadow-2);
	}
	.card:focus-visible.fx-tilt { transform: none; }

	.card-cover {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--bg-2);
		border: 1px solid var(--line-0);
		transition: border-color var(--motion-fast), box-shadow var(--motion-fast);
	}
	.card:hover .card-cover {
		border-color: var(--line-2);
		box-shadow: var(--shadow-2);
	}
	.card-cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--motion-base) var(--ease-out-soft);
	}
	.card:hover .card-cover img { transform: scale(1.04); }

	.card-cover-empty {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		color: var(--fg-3);
	}

	.card-type {
		position: absolute;
		top: var(--space-2);
		left: var(--space-2);
		width: 24px;
		height: 24px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(10, 10, 12, 0.7);
		backdrop-filter: blur(var(--blur-glass-1));
		border-radius: var(--radius-sm);
		color: var(--fg-0);
	}
	.card-type--flash { color: var(--semantic-flash); }
	.card-type--retro { color: var(--semantic-retro); }
	.card-type--webgl { color: var(--semantic-webgl); }

	.card-fav {
		position: absolute;
		top: var(--space-2);
		right: var(--space-2);
		width: 28px;
		height: 28px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(10, 10, 12, 0.7);
		backdrop-filter: blur(var(--blur-glass-1));
		border-radius: var(--radius-sm);
		color: var(--fg-1);
		cursor: pointer;
		opacity: 0;
		transform: translateY(-2px);
		transition: opacity var(--motion-fast), transform var(--motion-fast), color var(--motion-fast);
	}
	.card:hover .card-fav, .card-fav:focus-visible, .card-fav.is-active {
		opacity: 1;
		transform: translateY(0);
	}
	.card-fav.is-active { color: var(--semantic-retro); }
	.card-fav:hover { color: var(--semantic-retro); }

	.card-broken-ribbon {
		position: absolute;
		left: 0; right: 0; bottom: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-1);
		padding: var(--space-1);
		color: white;
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
	}
	/* Tier the ribbon color by verdict — broken is the urgent red, probable
	   is the warn amber. Triple-confirm rules in build-game-health.js drive
	   which class lands on the card. */
	.card--broken .card-broken-ribbon  { background: color-mix(in srgb, var(--semantic-broken) 85%, transparent); }
	.card--probable .card-broken-ribbon { background: color-mix(in srgb, var(--semantic-warn) 85%, transparent); }

	.card--broken .card-cover img { filter: grayscale(0.6) brightness(0.7); }
	.card--probable .card-cover img { filter: brightness(0.85); }
	/* Unverified games stay live in the catalog but get a subtle dim so
	   power users can tell at a glance which ones haven't been re-checked
	   recently. No ribbon — too noisy when most games are unverified
	   during the migration window. */
	.card--unverified .card-cover { border-color: var(--line-0); }
	.card--unverified .card-cover img { opacity: 0.92; }

	.card-meta {
		padding: 0 var(--space-1);
	}
	.card-title {
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--fg-0);
		line-height: var(--leading-snug);
		overflow: hidden;
		text-overflow: ellipsis;
		display: -webkit-box;
		-webkit-line-clamp: 1;
		-webkit-box-orient: vertical;
	}
	.card-sub {
		margin-top: 4px;
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		min-height: calc(var(--text-xs) + 4px);
	}
	.card-chip {
		display: inline-flex;
		align-items: center;
		padding: 1px 6px;
		border-radius: var(--radius-pill);
		font-size: var(--text-xs);
		font-weight: var(--weight-medium);
		background: var(--bg-2);
		color: var(--fg-2);
		border: 1px solid var(--line-0);
		line-height: var(--leading-snug);
	}
	.card-chip--ghost {
		background: transparent;
		border-color: transparent;
		padding-left: 0;
	}
	.card-chip--diff-easy {
		color: color-mix(in srgb, var(--semantic-ok, #4ade80) 90%, white);
		background: color-mix(in srgb, var(--semantic-ok, #4ade80) 15%, var(--bg-2));
		border-color: color-mix(in srgb, var(--semantic-ok, #4ade80) 25%, transparent);
	}
	.card-chip--diff-med {
		color: var(--fg-1);
	}
	.card-chip--diff-hard {
		color: color-mix(in srgb, var(--semantic-warn, #f59e0b) 90%, white);
		background: color-mix(in srgb, var(--semantic-warn, #f59e0b) 18%, var(--bg-2));
		border-color: color-mix(in srgb, var(--semantic-warn, #f59e0b) 30%, transparent);
	}
	.card-chip--time {
		color: var(--fg-2);
	}

	.card--compact .card-title { font-size: var(--text-xs); }
	.card--compact .card-sub { display: none; }

	/* Touch parity — heart visible on touch devices. */
	@media (hover: none) {
		.card-fav { opacity: 1; transform: none; }
	}
</style>
