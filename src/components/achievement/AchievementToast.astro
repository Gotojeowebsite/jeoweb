---
/**
 * Achievement toast host. Stays in the DOM, rendered empty; the
 * achievement-bindings script populates it on the `jeo:achievement-unlock`
 * CustomEvent. One toast at a time; queue overflow is dropped silently.
 */
---
<div id="jeo-achievement-toast" class="achievement-toast" role="status" aria-live="polite" hidden></div>

<style is:global>
	.achievement-toast {
		position: fixed;
		bottom: var(--space-6);
		right: var(--space-6);
		z-index: var(--z-toast);
		max-width: 360px;
		padding: var(--space-4) var(--space-5);
		display: flex;
		align-items: center;
		gap: var(--space-4);
		background: var(--bg-1);
		border: 1px solid var(--line-2);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-3);
		color: var(--fg-0);
		animation: jeo-pop var(--motion-base) var(--ease-jeo-pop) both;
	}
	.achievement-toast[hidden] { display: none; }
	.achievement-toast__icon {
		width: 42px;
		height: 42px;
		border-radius: var(--radius-md);
		background: var(--gradient-aurora);
		display: flex;
		align-items: center;
		justify-content: center;
		color: white;
		flex-shrink: 0;
	}
	.achievement-toast__body { min-width: 0; }
	.achievement-toast__eyebrow {
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		background: var(--gradient-aurora);
		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
	}
	.achievement-toast__name {
		font-size: var(--text-body);
		font-weight: var(--weight-semibold);
		margin-top: 2px;
	}
	.achievement-toast__desc {
		font-size: var(--text-xs);
		color: var(--fg-2);
		margin-top: 2px;
	}
	@media (max-width: 540px) {
		.achievement-toast { left: var(--space-4); right: var(--space-4); max-width: none; }
	}
</style>
