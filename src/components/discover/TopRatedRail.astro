---
/**
 * TopRatedRail — A client-side-only carousel that fetches the global top-rated
 * games from the Cloudflare Worker backend and renders them as a scrollable
 * rail. Hidden until backend data arrives (gracefully degrades when no backend
 * is configured).
 *
 * The DOM skeleton is rendered at build time; the actual game cards are
 * injected by the <script> block after the page loads and ratings are fetched.
 */
---
<section class="rail top-rated-rail" id="top-rated-rail" aria-label="Top Rated Games" hidden>
	<div class="rail-head">
		<h2 class="section-title">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
			</svg>
			Top Rated
			<span class="count" id="top-rated-count">0</span>
		</h2>
		<div class="rail-controls">
			<div class="rail-arrows">
				<button class="rail-arrow" data-target="top-rated-track" data-direction="-1" aria-label="Scroll left">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
				</button>
				<button class="rail-arrow" data-target="top-rated-track" data-direction="1" aria-label="Scroll right">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
				</button>
			</div>
		</div>
	</div>
	<div class="rail-track" id="top-rated-track" tabindex="0">
		<!-- Populated by client-side JS -->
	</div>
</section>

<script>
// ── Top Rated Rail ──────────────────────────────────────────────────────────
// Reads global ratings from JeoRatings (or fetches directly from the backend),
// maps them onto the game catalog SSR cards, and populates the rail.

interface RatingEntry { avg: number; count: number; }

function resolveBackendUrl(): string | null {
	try {
		const ls = localStorage.getItem('jeo:backendUrl');
		if (ls && /^https?:\/\//.test(ls) && !/REPLACE|YOUR-/i.test(ls)) return ls.replace(/\/+$/, '');
	} catch {}
	const meta = document.querySelector<HTMLMetaElement>('meta[name="jeo-backend"]');
	const v = meta?.content?.trim();
	if (v && /^https?:\/\//.test(v) && !/REPLACE|YOUR-/i.test(v)) return v.replace(/\/+$/, '');
	return null;
}

function fmtCount(n: number): string {
	return n >= 1000 ? (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k' : String(n);
}

function fmtAvg(n: number): string {
	return Number(n).toFixed(1);
}

async function loadRatings(): Promise<Record<string, RatingEntry>> {
	// 1. Ask JeoRatings (already cached / fetching)
	const jr = (window as any).JeoRatings;
	if (jr) {
		const data = await jr.fetchGlobalRatings();
		if (data && typeof data === 'object' && Object.keys(data).length) return data;
	}

	// 2. Direct fetch fallback
	const url = resolveBackendUrl();
	if (!url) return {};
	try {
		const res = await fetch(url + '/api/ratings', { signal: AbortSignal.timeout(6000) });
		if (!res.ok) return {};
		const json = await res.json() as { ratings?: Record<string, RatingEntry> };
		return json?.ratings ?? {};
	} catch {
		return {};
	}
}

/**
 * Build a card element for a game. Mirrors the SSR GameCard structure so
 * all existing CSS rules apply without duplication.
 */
function buildCard(slug: string, name: string, image: string | null, type: string, rating: RatingEntry): HTMLAnchorElement {
	const a = document.createElement('a');
	a.className = 'card fx-tilt fx-ripple';
	a.href = `/play/${slug}`;
	a.dataset.slug = slug;

	const displayName = name
		.replace(/([a-z0-9])([A-Z])/g, '$1 $2')
		.replace(/[-_.]+/g, ' ')
		.replace(/\s+/g, ' ')
		.trim()
		.split(' ')
		.map((w: string, i: number) => {
			const acronyms = new Set(['IO','FPS','RPG','TD','RTS','2D','3D','VR','NES','SNES','GBA']);
			if (acronyms.has(w.toUpperCase())) return w.toUpperCase();
			return i === 0 ? w.charAt(0).toUpperCase() + w.slice(1).toLowerCase() : w.toLowerCase();
		})
		.join(' ');

	const imgHtml = image
		? `<picture>
			${!/\.(webp|svg|ico|gif)$/i.test(image) ? `<source srcset="/${image.replace(/\.[^.]+$/, '.webp')}" type="image/webp">` : ''}
			<img src="/${image}" alt="" loading="lazy" decoding="async" width="400" height="225">
		   </picture>`
		: `<div class="card-cover-empty" aria-hidden="true"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="6" rx="3"/><line x1="6" x2="10" y1="12" y2="12"/><line x1="8" x2="8" y1="10" y2="14"/><circle cx="15" cy="11" r=".5" fill="currentColor"/><circle cx="17" cy="13" r=".5" fill="currentColor"/></svg></div>`;

	const typeIcons: Record<string, string> = {
		flash: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
		retro: '<rect width="20" height="14" x="2" y="6" rx="3"/><circle cx="8" cy="12" r="1.2"/><circle cx="11" cy="12" r="1.2"/><circle cx="14" cy="12" r="1.2"/><circle cx="17" cy="12" r="1.2"/>',
		webgl: '<path d="M9.94 2.83 12 5l2.06-2.17a4 4 0 0 1 5.66 5.66L12 16l-7.71-7.51a4 4 0 0 1 5.65-5.66Z"/>',
	};

	const stars = fmtAvg(rating.avg);
	const cnt   = fmtCount(rating.count);

	a.innerHTML = `
		<div class="card-cover">
			${imgHtml}
			<span class="card-type card-type--${type}" title="${type}">
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${typeIcons[type] ?? typeIcons.webgl}</svg>
			</span>
			<span class="top-rated-badge" aria-label="${stars} stars from ${cnt} ratings">★ ${stars}</span>
		</div>
		<div class="card-meta">
			<div class="card-title">${displayName}</div>
			<div class="card-sub">
				<span class="card-chip card-chip--star">${stars} ★ <small>(${cnt})</small></span>
			</div>
		</div>
	`;
	return a;
}

async function bootstrap() {
	const section = document.getElementById('top-rated-rail');
	const track   = document.getElementById('top-rated-track');
	const cntEl   = document.getElementById('top-rated-count');
	if (!section || !track) return;

	// Build an index of SSR cards so we can pull image/type/name from them
	const cardIndex = new Map<string, { name: string; image: string | null; type: string }>();
	document.querySelectorAll<HTMLAnchorElement>('a.card[data-slug]').forEach(el => {
		const slug = el.dataset.slug ?? '';
		if (!slug) return;
		const name  = el.dataset.name ?? slug;
		const type  = el.dataset.type ?? 'webgl';
		const imgEl = el.querySelector('img');
		const image = imgEl?.getAttribute('src')?.replace(/^\//, '') ?? null;
		cardIndex.set(slug, { name, image, type });
	});

	const ratings = await loadRatings();
	const sorted = Object.entries(ratings)
		.filter(([, r]) => r && r.count >= 1 && r.avg > 0)
		.sort(([, a], [, b]) => {
			if (b.avg !== a.avg) return b.avg - a.avg;
			return b.count - a.count;
		})
		.slice(0, 24);

	if (sorted.length < 3) return; // too sparse — keep hidden

	const frag = document.createDocumentFragment();
	let rendered = 0;
	for (const [slug, rating] of sorted) {
		const info = cardIndex.get(slug);
		if (!info) continue; // game not in catalog
		const item = document.createElement('div');
		item.className = 'rail-item';
		item.appendChild(buildCard(slug, info.name, info.image, info.type, rating));
		frag.appendChild(item);
		rendered++;
	}

	if (rendered < 3) return; // not enough real catalog matches

	track.appendChild(frag);
	if (cntEl) cntEl.textContent = String(rendered);
	section.hidden = false;
}

// Run after first paint — don't block DOMContentLoaded
if (document.readyState === 'loading') {
	document.addEventListener('DOMContentLoaded', () => setTimeout(bootstrap, 600));
} else {
	setTimeout(bootstrap, 600);
}

// Re-run when fresh global data arrives from ratings.js
window.addEventListener('jeo:ratingsUpdated', () => {
	const section = document.getElementById('top-rated-rail');
	if (!section?.hidden) return; // already shown — don't re-render (avoid flicker)
	bootstrap();
});

// Arrow controls
document.querySelectorAll<HTMLButtonElement>('.rail-arrow').forEach(btn => {
	btn.addEventListener('click', () => {
		const targetId = btn.dataset.target;
		const dir = Number(btn.dataset.direction ?? 1);
		if (!targetId) return;
		const track = document.getElementById(targetId);
		if (!track) return;
		const step = track.clientWidth * 0.85;
		track.scrollBy({ left: step * dir, behavior: 'smooth' });
	});
});
</script>

<style>
.top-rated-rail { margin-bottom: var(--space-8); }

/* Gold-tinted rating badge overlaid on the card cover */
.top-rated-badge {
	position: absolute;
	bottom: var(--space-2);
	right: var(--space-2);
	padding: 2px 8px;
	background: rgba(10, 10, 12, 0.75);
	backdrop-filter: blur(var(--blur-glass-1));
	border-radius: var(--radius-pill);
	font-size: var(--text-xs);
	font-weight: var(--weight-semibold);
	color: hsl(43 96% 65%);
	letter-spacing: 0.3px;
}

.card-chip--star {
	color: hsl(43 96% 55%);
	background: color-mix(in oklab, hsl(43 96% 55%) 14%, var(--bg-2));
	border-color: color-mix(in oklab, hsl(43 96% 55%) 28%, transparent);
}
.card-chip--star small {
	opacity: 0.7;
	font-size: 0.85em;
}
</style>
