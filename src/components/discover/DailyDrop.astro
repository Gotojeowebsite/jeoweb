---
/**
 * "Daily Drop" — a hand-picked-feeling, deterministic-per-day game. Uses
 * a different salt than the hero's pickOfTheDay so the two never collide
 * on the same day.
 */
import Icon from '../Icon.astro';
import Jeo from '../mascot/Jeo.astro';
import { getAllGames, gameSlug, gameTypeLabel, pickOfTheDay, type Game } from '../../lib/catalog';
import { DAILY_DROP_INTRO, pickDaily } from '../../lib/voice';

const eligible = getAllGames().filter(g => g.image && g.status !== 'broken' && g.status !== 'maintenance');
const dateKey = new Date().toISOString().slice(0, 10);
const game: Game | null = pickOfTheDay(eligible, dateKey + '-drop');
const slug = game ? gameSlug(game) : '';
const intro = pickDaily(DAILY_DROP_INTRO);
---
{game && (
	<section class="daily-drop" aria-label="Daily Drop">
		<div class="daily-drop__art" style={`background-image:url('/${game.image}');`}></div>
		<div class="daily-drop__veil"></div>
		<div class="daily-drop__mascot" aria-hidden="true">
			<Jeo pose="thinking" size={96} />
		</div>
		<div class="daily-drop__body">
			<div class="daily-drop__eyebrow">
				<Icon name="sparkles" size={12} />
				<span>Daily Drop</span>
			</div>
			<div class="daily-drop__intro">{intro}</div>
			<h3 class="daily-drop__title">{game.name}</h3>
			<div class="daily-drop__tags">
				<span class:list={['chip', `chip--${game.type}`]}>
					<Icon name={game.type === 'flash' ? 'zap' : game.type === 'retro' ? 'gamepad' : 'sparkles'} size={12} />
					{gameTypeLabel(game.type)}
				</span>
				{game.tags?.slice(0, 2).map(t => <span class="chip">{t}</span>)}
			</div>
		</div>
		<div class="daily-drop__actions">
			<a class="btn btn--primary fx-ripple" href={`/play/${slug}`}>
				<Icon name="play" size={14} />Play it
			</a>
			<a class="btn btn--ghost" href={`/game/${slug}`}>More</a>
		</div>
	</section>
)}

<style>
	.daily-drop {
		position: relative;
		display: grid;
		grid-template-columns: 96px 1fr auto;
		gap: var(--space-5);
		align-items: center;
		padding: var(--space-5) var(--space-6);
		border-radius: var(--radius-2xl);
		overflow: hidden;
		isolation: isolate;
		background: var(--bg-1);
		border: 1px solid var(--line-1);
	}
	.daily-drop__art {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		filter: blur(32px) saturate(1.3);
		opacity: 0.35;
		z-index: -2;
		transform: scale(1.1);
	}
	.daily-drop__veil {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, var(--bg-1) 0%, color-mix(in srgb, var(--bg-1) 65%, transparent) 100%);
		z-index: -1;
	}
	.daily-drop__mascot { z-index: 1; }
	.daily-drop__body { min-width: 0; }
	.daily-drop__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		padding: 2px var(--space-2);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		background: var(--gradient-aurora);
		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
	}
	.daily-drop__intro {
		font-size: var(--text-sm);
		color: var(--fg-2);
		margin-top: 2px;
	}
	.daily-drop__title {
		font-family: var(--font-display);
		font-size: var(--text-h2);
		font-weight: var(--weight-display);
		letter-spacing: -0.02em;
		margin-top: var(--space-2);
	}
	.daily-drop__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-2);
	}
	.daily-drop__actions {
		display: flex;
		gap: var(--space-2);
		align-items: center;
	}
	@media (max-width: 720px) {
		.daily-drop {
			grid-template-columns: 1fr;
			gap: var(--space-3);
			text-align: left;
		}
		.daily-drop__mascot { display: none; }
		.daily-drop__actions { flex-wrap: wrap; }
	}
</style>
