---
/*
 * Cmd-K command palette mount point. Reads the catalog at build time,
 * serializes a trim shape (slug + name + type + tags + status) onto the
 * island so the client doesn't refetch. Hotkey, fuzzy ranking,
 * favorites + recently-played pinned to the top — all client-side.
 *
 * Plan reference: Phase 4 Track B Sprint 4.
 */
import { getAllGames, gameSlug } from '../lib/catalog';
import CommandPalette from './CommandPalette.island.tsx';

// PaletteGame.status doesn't allow 'unknown' — coerce it away.
type PaletteStatus = 'broken' | 'maintenance' | 'unverified' | 'probable_broken' | 'healthy';
const KNOWN: PaletteStatus[] = ['broken', 'maintenance', 'unverified', 'probable_broken', 'healthy'];
const games = getAllGames().map((g) => ({
	slug: gameSlug(g),
	name: g.name,
	type: g.type,
	tags: g.tags ?? [],
	status: (KNOWN as readonly string[]).includes(g.status as string) ? (g.status as PaletteStatus) : undefined,
}));
---

<CommandPalette games={games} client:load />

<style is:global>
	.jeo-cmdk-backdrop {
		position: fixed;
		inset: 0;
		z-index: var(--z-modal);
		background: var(--surface-overlay);
		backdrop-filter: blur(var(--blur-glass-2));
		-webkit-backdrop-filter: blur(var(--blur-glass-2));
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding-top: 12vh;
		animation: jeo-cmdk-fade-in var(--motion-fast) var(--ease-out-soft);
	}
	@keyframes jeo-cmdk-fade-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}
	.jeo-cmdk {
		width: min(600px, 92vw);
		background: var(--bg-1);
		border: 1px solid var(--line-2);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-4);
		color: var(--fg-0);
		display: flex;
		flex-direction: column;
		overflow: hidden;
		animation: jeo-cmdk-pop var(--motion-base) var(--ease-spring);
	}
	@keyframes jeo-cmdk-pop {
		from { opacity: 0; transform: scale(0.97) translateY(-4px); }
		to { opacity: 1; transform: scale(1) translateY(0); }
	}
	.jeo-cmdk__input {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-4) var(--space-5);
		border-bottom: 1px solid var(--line-0);
		color: var(--fg-2);
	}
	.jeo-cmdk__input input {
		flex: 1;
		background: transparent;
		border: none;
		outline: none;
		font: inherit;
		font-size: var(--text-body);
		color: var(--fg-0);
	}
	.jeo-cmdk__input input::placeholder { color: var(--fg-3); }
	.jeo-cmdk__input kbd,
	.jeo-cmdk__hint kbd {
		font: inherit;
		font-size: var(--text-xs);
		font-family: var(--font-mono);
		background: var(--bg-2);
		color: var(--fg-1);
		border: 1px solid var(--line-1);
		border-radius: var(--radius-sm);
		padding: 1px 6px;
	}
	.jeo-cmdk__section-label {
		padding: var(--space-2) var(--space-5);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--fg-3);
	}
	.jeo-cmdk__list {
		list-style: none;
		margin: 0;
		padding: 0 var(--space-2) var(--space-2);
		max-height: 50vh;
		overflow-y: auto;
	}
	.jeo-cmdk__item {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-sm);
		cursor: pointer;
		font-size: var(--text-body);
		color: var(--fg-0);
		transition: background var(--motion-fast) var(--ease-out-soft);
	}
	.jeo-cmdk__item.is-active {
		background: var(--accent-soft);
	}
	.jeo-cmdk__type {
		width: 20px;
		display: inline-flex;
		justify-content: center;
		font-size: var(--text-sm);
	}
	.jeo-cmdk__name {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.jeo-cmdk__tag {
		font-size: var(--text-xs);
		padding: 1px var(--space-2);
		border-radius: var(--radius-pill);
		background: var(--bg-2);
		color: var(--fg-2);
	}
	.jeo-cmdk__tag--broken {
		background: color-mix(in srgb, var(--semantic-broken) 25%, transparent);
		color: var(--semantic-broken);
	}
	.jeo-cmdk__tag--warn {
		background: color-mix(in srgb, var(--semantic-warn) 25%, transparent);
		color: var(--semantic-warn);
	}
	.jeo-cmdk__enter {
		opacity: 0;
		font-size: var(--text-sm);
		color: var(--fg-2);
		transition: opacity var(--motion-fast);
	}
	.jeo-cmdk__item.is-active .jeo-cmdk__enter { opacity: 1; }
	.jeo-cmdk__empty {
		padding: var(--space-4) var(--space-3);
		text-align: center;
		color: var(--fg-3);
		font-size: var(--text-sm);
	}
	.jeo-cmdk__hint {
		padding: var(--space-3) var(--space-5);
		border-top: 1px solid var(--line-0);
		font-size: var(--text-xs);
		color: var(--fg-3);
		display: flex;
		gap: var(--space-3);
		flex-wrap: wrap;
	}
</style>
