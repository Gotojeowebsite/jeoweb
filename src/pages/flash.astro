---
import Site from '../layouts/Site.astro';
import FiltersBar from '../components/discover/FiltersBar.astro';
import GameGrid from '../components/discover/GameGrid.astro';
import { getAllGames, getCatalogStats } from '../lib/catalog';

const games = getAllGames().filter(g => g.type === 'flash');
const stats = getCatalogStats();
---
<Site
	title={`${stats.flash} Flash games — preserved with Ruffle`}
	description={`Play ${stats.flash} classic Flash games right in the browser. Powered by Ruffle, no downloads.`}
	current="flash"
>
	<div class="content-wrap">
		<header class="page-header">
			<h1>Flash games</h1>
			<p>{stats.flash.toLocaleString()} preserved Flash classics. Powered by Ruffle — no Flash plugin required.</p>
		</header>
		<FiltersBar />
		<GameGrid games={games} />
	</div>
</Site>

<script>
	import '../scripts/grid-runtime';
</script>

<style>
	.page-header { margin: var(--space-5) 0 var(--space-7); }
	.page-header h1 { font-size: var(--text-h1); letter-spacing: -0.04em; }
	.page-header p { color: var(--fg-1); max-width: var(--max-w-prose); margin-top: var(--space-2); }
</style>
