---
import Site from '../../layouts/Site.astro';
import Icon from '../../components/Icon.astro';
import LaunchOverlay from '../../components/play/LaunchOverlay.astro';
import { getAllGames, gameSlug, gameTypeLabel, type Game } from '../../lib/catalog';

export async function getStaticPaths() {
	const games = getAllGames();
	return games.map(g => ({ params: { slug: gameSlug(g) }, props: { game: g } }));
}

interface Props { game: Game; }
const { game } = Astro.props;
const slug = gameSlug(game);
const iframeSrc = '/' + game.url;
---
<Site
	title={`Play ${game.name}`}
	description={`Play ${game.name} free on Jeo`}
	bodyClass="play-body"
>
	<div
		class="player"
		data-jeo-game
		data-slug={slug}
		data-name={game.name}
		data-image={game.image ?? ''}
		data-type={game.type}
		data-tags={(game.tags ?? []).join('|')}
	>
		<div class="player-top">
			<a class="player-back" href={`/game/${slug}`}>
				<Icon name="arrow-left" size={16} />
				<span class="hide-narrow">Back</span>
			</a>
			<div class="player-title">
				<span class:list={['chip', `chip--${game.type}`]}>
					<Icon name={game.type === 'flash' ? 'zap' : game.type === 'retro' ? 'gamepad' : 'sparkles'} size={12} />
					{gameTypeLabel(game.type)}
				</span>
				<h1>{game.name}</h1>
			</div>
			<div class="player-actions">
				<button class="topbar-icon-btn" id="player-lights" aria-label="Turn off lights" title="Lights Out">
					<Icon name="moon" size={18} />
				</button>
				<button class="topbar-icon-btn" id="player-theater" aria-label="Theater mode" title="Theater Mode">
					<Icon name="eye" size={18} />
				</button>
				<button class="topbar-icon-btn" id="player-reload" aria-label="Reload game" title="Reload Game">
					<Icon name="refresh" size={18} />
				</button>
				<button class="topbar-icon-btn" id="player-fullscreen" aria-label="Fullscreen" title="Fullscreen">
					<Icon name="maximize" size={18} />
				</button>
				<button class="topbar-icon-btn" data-share-url={`https://jeoweb.app/game/${slug}`} aria-label="Share" title="Share">
					<Icon name="share" size={18} />
				</button>
				<a class="topbar-icon-btn" href={iframeSrc} target="_blank" rel="noopener" aria-label="Open in new tab" title="Open in new tab">
					<Icon name="external" size={18} />
				</a>
				<button class="btn btn--danger btn--sm" id="player-panic" type="button" title="Panic Button">
					<Icon name="shield" size={14} />Panic
				</button>
				<a class="btn btn--secondary btn--sm" href={`/game/${slug}`}>
					<Icon name="x" size={14} />Exit
				</a>
			</div>
		</div>
		<div class="player-stage" id="player-stage">
			<LaunchOverlay game={game} slug={slug} />
			<iframe
				id="player-frame"
				src={iframeSrc}
				title={game.name}
				transition:persist="player-frame"
				allow="autoplay; fullscreen; pointer-lock; gamepad; clipboard-read; clipboard-write"
				sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox allow-top-navigation-by-user-activation allow-modals allow-pointer-lock allow-orientation-lock allow-presentation"
			></iframe>
		</div>
	</div>

	<script>
		import '../../scripts/recent';
		import { recordPlayEnd } from '../../lib/achievements';
		const stage = document.getElementById('player-stage');
		const frame = document.getElementById('player-frame') as HTMLIFrameElement | null;
		const fsBtn = document.getElementById('player-fullscreen');
		const sessionStart = Date.now();

		fsBtn?.addEventListener('click', async () => {
			if (!stage) return;
			if (document.fullscreenElement) await document.exitFullscreen();
			else await stage.requestFullscreen();
		});

		// Lights out toggle
		const lightsBtn = document.getElementById('player-lights');
		lightsBtn?.addEventListener('click', () => {
			document.body.classList.toggle('lights-out');
			lightsBtn.classList.toggle('is-active');
		});

		// Theater mode toggle
		const theaterBtn = document.getElementById('player-theater');
		theaterBtn?.addEventListener('click', () => {
			document.body.classList.toggle('theater-mode');
			theaterBtn.classList.toggle('is-active');
		});

		// Reload game
		const reloadBtn = document.getElementById('player-reload');
		reloadBtn?.addEventListener('click', () => {
			if (frame) {
				const src = frame.src;
				frame.src = '';
				frame.src = src;
			}
		});

		// Panic button click
		const panicBtn = document.getElementById('player-panic');
		panicBtn?.addEventListener('click', () => {
			import('../../lib/storage').then(({ readPrefs }) => {
				const prefs = readPrefs();
				window.location.replace(prefs.panicUrl || 'https://classroom.google.com');
			});
		});

		document.addEventListener('click', async e => {
			const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-share-url]');
			if (!btn) return;
			const url = btn.dataset.shareUrl!;
			if (navigator.share) {
				try { await navigator.share({ url, title: document.title }); } catch (_) {}
			} else {
				await navigator.clipboard?.writeText(url);
			}
		});

		// Marathon achievement: 30-minute single-session play.
		window.addEventListener('beforeunload', () => {
			try { recordPlayEnd(Date.now() - sessionStart); } catch (_) {}
		});
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) {
				try { recordPlayEnd(Date.now() - sessionStart); } catch (_) {}
			}
		});
		// Silence unused-warning on frame in case future refactors drop it.
		void frame;
	</script>
</Site>

<style is:global>
	body.play-body { background: var(--bg-0); }
	body.play-body .site-footer,
	body.play-body .sticky-resume { display: none; }

	/* Lights out styling */
	body.lights-out {
		background: #000000 !important;
	}
	body.lights-out .topbar,
	body.lights-out .player-top {
		opacity: 0.15;
		transition: opacity var(--motion-base);
	}
	body.lights-out .topbar:hover,
	body.lights-out .player-top:hover {
		opacity: 1;
	}

	/* Theater mode styling */
	body.theater-mode {
		overflow: hidden;
	}
	body.theater-mode .topbar {
		display: none !important;
	}
	body.theater-mode .player {
		height: 100dvh !important;
	}
</style>

<style>
	.player {
		display: flex;
		flex-direction: column;
		height: calc(100dvh - var(--header-h));
	}
	.player-top {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-4);
		background: var(--bg-1);
		border-bottom: 1px solid var(--line-1);
		flex-shrink: 0;
	}
	.player-back {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-3);
		color: var(--fg-1);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		border-radius: var(--radius-md);
		transition: background var(--motion-fast);
	}
	.player-back:hover { background: var(--bg-2); color: var(--fg-0); }
	.player-title {
		flex: 1;
		display: flex;
		align-items: center;
		gap: var(--space-3);
		overflow: hidden;
	}
	.player-title h1 {
		font-size: var(--text-body);
		font-weight: var(--weight-semibold);
		letter-spacing: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.player-actions {
		display: flex;
		align-items: center;
		gap: var(--space-1);
	}
	.player-stage {
		position: relative;
		flex: 1;
		background: #000;
	}
	.player-stage iframe {
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
	}
	.hide-narrow { display: inline; }
	@media (max-width: 600px) {
		.hide-narrow { display: none; }
		.player-title h1 { font-size: var(--text-sm); }
	}
</style>
