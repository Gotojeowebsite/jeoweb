---
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import { getAllGames, pickOfTheDay, gameSlug } from '../lib/catalog';

// Stable deterministic suggestion so the 404 isn't a dead-end.
const suggestion = pickOfTheDay(getAllGames().filter(g => g.image && !g.requested && g.status !== 'broken'));
const suggSlug = suggestion ? gameSlug(suggestion) : '';
---
<Site title="Not found" description="The page you're looking for couldn't be found.">
	<div class="content-wrap notfound">
		<div class="notfound-shell">
			<div class="notfound-glyph" aria-hidden="true">404</div>
			<h1>We couldn't find that page.</h1>
			<p>The link might be old, or the game got renamed. Try one of these:</p>
			<div class="notfound-actions">
				<a class="btn btn--primary" href="/">
					<Icon name="arrow-left" size={14} />Back home
				</a>
				<a class="btn btn--secondary" href="/?action=surprise">
					<Icon name="dice" size={14} />Surprise me
				</a>
				{suggestion && (
					<a class="btn btn--ghost" href={`/game/${suggSlug}`}>
						<Icon name="sparkles" size={14} />Try {suggestion.name}
					</a>
				)}
			</div>
		</div>
	</div>
</Site>

<style>
	.notfound { min-height: 60dvh; display: grid; place-items: center; }
	.notfound-shell {
		max-width: 560px;
		padding: var(--space-9) var(--space-6);
		text-align: center;
		background: var(--bg-1);
		border: 1px solid var(--line-1);
		border-radius: var(--radius-2xl);
	}
	.notfound-glyph {
		font-family: var(--font-display);
		font-size: clamp(5rem, 12vw, 8rem);
		font-weight: var(--weight-display);
		letter-spacing: -0.06em;
		background: linear-gradient(135deg, var(--brand-300), var(--semantic-retro));
		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
		line-height: 0.9;
		margin-bottom: var(--space-4);
	}
	.notfound h1 {
		font-size: var(--text-h2);
		letter-spacing: -0.02em;
		margin-bottom: var(--space-3);
	}
	.notfound p {
		color: var(--fg-1);
		margin-bottom: var(--space-6);
	}
	.notfound-actions {
		display: flex;
		justify-content: center;
		gap: var(--space-3);
		flex-wrap: wrap;
	}
</style>
