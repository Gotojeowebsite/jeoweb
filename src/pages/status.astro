---
import Site from '../layouts/Site.astro';
import { getAllGames, getHealth, getHealthGeneratedAt, gameSlug, type Verdict } from '../lib/catalog';

const games = getAllGames();
const health = getHealth();

const buckets: Record<Verdict, number> = { healthy: 0, broken: 0, unknown: 0 };
const broken: { name: string; slug: string; verdict: Verdict }[] = [];
for (const g of games) {
	const slug = gameSlug(g);
	const v = health[slug];
	const verdict: Verdict = v?.verdict ?? (g.status === 'broken' ? 'broken' : 'unknown');
	if (verdict === 'broken') {
		broken.push({ name: g.name, slug, verdict });
	}
	buckets[verdict] = (buckets[verdict] ?? 0) + 1;
}
broken.sort((a, b) => a.name.localeCompare(b.name));
const generatedAt = getHealthGeneratedAt();
---
<Site title="Catalog status" description="Live health status of every game on Jeo.">
	<div class="content-wrap">
		<header class="page-header">
			<h1>Catalog status</h1>
			<p>Live health of all {games.length.toLocaleString()} games. The scanner runs nightly and signals are merged in game_health.json.</p>
			{generatedAt > 0 && <p class="muted">Last refreshed: {new Date(generatedAt).toLocaleString()}</p>}
		</header>
		<div class="status-grid">
			<div class="status-card status-card--ok">
				<div class="status-value">{buckets.healthy.toLocaleString()}</div>
				<div class="status-label">Healthy</div>
			</div>
			<div class="status-card status-card--bad">
				<div class="status-value">{buckets.broken.toLocaleString()}</div>
				<div class="status-label">Broken</div>
			</div>
			<div class="status-card status-card--mute">
				<div class="status-value">{buckets.unknown.toLocaleString()}</div>
				<div class="status-label">Unknown</div>
			</div>
		</div>
		{broken.length > 0 && (
			<section class="status-list">
				<h2>Games currently down</h2>
				<ul>
					{broken.map(b => (
						<li>
							<a href={`/game/${b.slug}`}>{b.name}</a>
							<span class="status status--bad">{b.verdict}</span>
						</li>
					))}
				</ul>
			</section>
		)}
	</div>
</Site>

<style>
	.page-header { margin: var(--space-5) 0 var(--space-7); }
	.page-header h1 { font-size: var(--text-h1); letter-spacing: -0.04em; }
	.muted { color: var(--fg-2); font-size: var(--text-sm); margin-top: var(--space-1); }

	.status-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-4);
		margin-bottom: var(--space-8);
	}
	.status-card {
		padding: var(--space-5);
		background: var(--bg-1);
		border: 1px solid var(--line-1);
		border-radius: var(--radius-xl);
	}
	.status-card--ok   { border-color: rgba(34, 197, 94, 0.3); }
	.status-card--warn { border-color: rgba(245, 158, 11, 0.3); }
	.status-card--bad  { border-color: rgba(239, 68, 68, 0.3); }
	.status-value {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: var(--weight-bold);
		line-height: 1;
	}
	.status-label {
		margin-top: var(--space-1);
		color: var(--fg-2);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
	}

	.status-list h2 { font-size: var(--text-h2); margin-bottom: var(--space-4); }
	.status-list ul { display: flex; flex-direction: column; gap: var(--space-2); }
	.status-list li {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-4);
		background: var(--bg-1);
		border: 1px solid var(--line-1);
		border-radius: var(--radius-md);
	}

	@media (max-width: 640px) {
		.status-grid { grid-template-columns: repeat(2, 1fr); }
	}
</style>
