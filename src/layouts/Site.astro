---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/chrome.css';
import '../styles/motion.css';
import '../styles/mascot.css';
import '../styles/cursor.css';
import { ClientRouter } from 'astro:transitions';
import TopBar from '../components/chrome/TopBar.astro';
import Footer from '../components/chrome/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import StickyResume from '../components/play/StickyResume.astro';
import AchievementToast from '../components/achievement/AchievementToast.astro';

type NavCurrent = 'home' | 'flash' | 'retro' | 'new' | 'requested' | 'links' | 'logs' | 'host';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	canonical?: string;
	current?: NavCurrent;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	bodyClass?: string;
}

const {
	title,
	description = 'Free unblocked games portal — 596+ browser, Flash, and retro games. No downloads, no signups, just play.',
	ogImage = '/og-default.svg',
	canonical,
	current,
	jsonLd,
	bodyClass = '',
} = Astro.props;

const siteUrl = 'https://jeoweb.app';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const fullTitle = title.includes('Jeo') ? title : `${title} · Jeo`;
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const ld = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
	<title>{fullTitle}</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={canonicalUrl} />

	<meta name="theme-color" content="#0a0a0c" media="(prefers-color-scheme: dark)" />
	<meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
	<meta name="color-scheme" content="dark light" />

	<link rel="manifest" href="/manifest.json" />
	<link rel="icon" href="/icon.svg" type="image/svg+xml" />
	<link rel="apple-touch-icon" href="/icon.svg" />

	<ClientRouter />

	<!-- Open Graph -->
	<meta property="og:type" content="website" />
	<meta property="og:site_name" content="Jeo" />
	<meta property="og:title" content={fullTitle} />
	<meta property="og:description" content={description} />
	<meta property="og:url" content={canonicalUrl} />
	<meta property="og:image" content={ogImageAbsolute} />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />

	<!-- Twitter -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={fullTitle} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={ogImageAbsolute} />

	<!-- Theme + accent bootstrap. Inline, pre-paint, no flash. Reads the
	     unified jeo-prefs-v1 bag first; falls back to the legacy single
	     keys so visitors who only used the old SPA carry their settings
	     through the cutover. -->
	<script is:inline>
		(function () {
			try {
				var theme = null, accent = null;
				var raw = localStorage.getItem('jeo-prefs-v1');
				if (raw) {
					var p = JSON.parse(raw);
					if (p && p.v === 1) {
						if (p.theme === 'light' || p.theme === 'dark') theme = p.theme;
						if (p.accent && /^#[0-9a-f]{6}$/i.test(p.accent)) accent = p.accent;

						// Tab cloaker pre-paint
						if (p.cloakPreset && p.cloakPreset !== 'none') {
							var title = '';
							var icon = '';
							if (p.cloakPreset === 'classroom') { title = 'Classes'; icon = '/brand/classroom.png'; }
							else if (p.cloakPreset === 'drive') { title = 'My Drive - Google Drive'; icon = '/brand/drive.png'; }
							else if (p.cloakPreset === 'canvas') { title = 'Dashboard'; icon = '/brand/canvas.png'; }
							else if (p.cloakPreset === 'docs') { title = 'Untitled document - Google Docs'; icon = '/brand/docs.png'; }
							else if (p.cloakPreset === 'custom') { title = p.cloakTitle || 'Google'; icon = p.cloakIcon || 'https://www.google.com/favicon.ico'; }
							
							if (title) {
								document.title = title;
								var link = document.querySelector('link[rel="icon"]');
								if (link) link.setAttribute('href', icon);
								var shortcutLink = document.querySelector('link[rel="shortcut icon"]');
								if (shortcutLink) shortcutLink.setAttribute('href', icon);
								var appleLink = document.querySelector('link[rel="apple-touch-icon"]');
								if (appleLink) appleLink.setAttribute('href', icon);
							}
						}

						// Custom cursor style
						if (p.cursorStyle && p.cursorStyle !== 'default') {
							document.documentElement.classList.add('cursor--' + p.cursorStyle);
						}
					}
				}
				if (!theme) {
					var legacy = localStorage.getItem('jeo-theme') || localStorage.getItem('site-theme');
					if (legacy === 'light' || legacy === 'dark') theme = legacy;
				}
				if (!accent) {
					var legacyA = localStorage.getItem('jeo-accent') || localStorage.getItem('site-accent');
					if (legacyA && /^#[0-9a-f]{6}$/i.test(legacyA)) accent = legacyA;
				}
				if (theme) {
					document.documentElement.setAttribute('data-theme', theme);
				} else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
					document.documentElement.setAttribute('data-theme', 'light');
				}
				if (accent) {
					document.documentElement.style.setProperty('--accent', accent);
				}
				// Premium FX — glass blur, 3D tilt, animated hero. Off by default
				// for max scroll perf; set via Settings → Animations & Effects.
				if (localStorage.getItem('jeo-fx-premium') === 'true') {
					document.documentElement.setAttribute('data-fx', 'premium');
				}
			} catch (_) {}
		})();
	</script>

	{ld.map(obj => (
		<script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />
	))}
</head>
<body class={bodyClass}>
	<a class="skip-link" href="#main">Skip to content</a>
	<TopBar current={current} />
	<main id="main">
		<slot />
	</main>
	<Footer />
	<CommandPalette />
	<StickyResume />
	<AchievementToast />

	<script>
		import { setPref, readPrefs } from '../lib/storage';
		import { applyCloak, setupPanicListener } from '../scripts/cloaker';
		import '../scripts/motion';
		import '../scripts/transitions';
		import '../scripts/sound-bindings';
		import '../scripts/achievement-bindings';
		import '../scripts/sw-register';

		// Run cloaker & panic runtime trigger on page load
		try {
			applyCloak();
			setupPanicListener();
		} catch (e) {
			console.error('Stealth system failed to start:', e);
		}

		// Watch Astro transitions to re-apply the tab cloak and panic key listeners
		document.addEventListener('astro:page-load', () => {
			try {
				applyCloak();
				setupPanicListener();
				
				// Re-apply cursor class to <html> after page navigation swaps <html>
				const prefs = readPrefs();
				document.documentElement.classList.remove('cursor--crosshair', 'cursor--neon', 'cursor--pixel');
				if (prefs.cursorStyle !== 'default') {
					document.documentElement.classList.add(`cursor--${prefs.cursorStyle}`);
				}
			} catch (e) {}
		});

		// Theme toggle — flip data-theme, swap icon, label, and persist via storage.ts.
		const toggle = document.getElementById('theme-toggle');
		const SUN  = '<path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/><circle cx="12" cy="12" r="4"/>';
		const MOON = '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>';

		function reflectTheme() {
			const cur = document.documentElement.getAttribute('data-theme') ?? 'dark';
			const svg = toggle?.querySelector('svg');
			if (svg) svg.innerHTML = cur === 'dark' ? MOON : SUN;
			if (toggle) toggle.setAttribute('aria-label', cur === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
		}
		reflectTheme();
		toggle?.addEventListener('click', () => {
			const cur = document.documentElement.getAttribute('data-theme') ?? 'dark';
			const next = cur === 'dark' ? 'light' : 'dark';
			document.documentElement.setAttribute('data-theme', next);
			setPref('theme', next);
			reflectTheme();
		});

		// Cmd-K trigger from the top bar's search button.
		document.getElementById('topbar-search')?.addEventListener('click', () => {
			document.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', ctrlKey: true, bubbles: true }));
			window.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', ctrlKey: true, bubbles: true }));
		});

		// Touch the prefs cache so legacy keys migrate on first paint.
		const prefs = readPrefs();

		// Apply cursor style on boot
		document.documentElement.classList.remove('cursor--crosshair', 'cursor--neon', 'cursor--pixel');
		if (prefs.cursorStyle !== 'default') {
			document.documentElement.classList.add(`cursor--${prefs.cursorStyle}`);
		}
	</script>
</body>
</html>
