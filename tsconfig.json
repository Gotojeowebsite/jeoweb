{
	"extends": "astro/tsconfigs/strict",
	"include": ["src/**/*", "astro.config.mjs"],
	"exclude": ["dist", "node_modules", "Assets", "scripts", "backend", "emulatorjs"],
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"~/*": ["src/*"]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "preact"
	}
}
