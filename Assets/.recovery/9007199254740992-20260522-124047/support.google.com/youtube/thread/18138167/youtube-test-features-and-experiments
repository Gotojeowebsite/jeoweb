sible by pulling the screen to refresh or scrolling up.\\u0026nbsp;\\u003c/div\\u003e\\u003cbr\\u003e\\u003cdiv\\u003eThese updates and more are currently rolling out slowly to a small percentage of viewers on Android and iOS globally. We’ll be testing to see if these changes simplify how you navigate your feeds and will keep you posted on the results. \\u003c/div\\u003e\\u003cdiv\\u003e\\u003cbr\\u003e\\u003c/div\\u003e\x22,[],[1,null,null,1778177486966291,402019709],null,null,null,null,null,null,100,null,null,null,1778177486966291,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,0.8808857798576355,0,\x22CiRhYmQ2MTVmMS0zYjgyLWVjYzYtN2E2ZS01MmY4MDUzMTA4MmYQBBgF\x22,\x221:43c629c5-f7b7-1dbc-a1ce-d7610007cc91\x22],null,null,null,null,\x22en\x22],null,[[\x22Dave (TeamYouTube)\x22,\x22https://storage.googleapis.com/support-forums-api/avatar/profile-402019709-950591653565795732.png\x22,1768424144995525],[null,1768425233351703,100,null,[7]],402019709,1],[null,null,0,0],0,null,[],[],null,[]]]],null,0,[\x22en\x22,1,[\x22en\x22,\x22en-AU\x22,\x22en-GB\x22,\x22en-au\x22,\x22en-gb\x22],\x22YouTube\x22,null,1,null,null,null,null,null,[[\x22watch_discover\x22,\x22Watching Videos\x22,1],[\x22create_manage\x22,\x22Uploading Videos\x22,1],[\x22account_youtube\x22,\x22My YouTube Account\x22,0],[\x22policy_copyright\x22,\x22YouTube Community Guidelines\x22,1],[\x22live_gaming\x22,\x22Live \\u0026 Gaming\x22,1],[\x22premium_purchased\x22,\x22Purchases \\u0026 Subscriptions (YouTube Premium, Memberships, YouTube TV and Primetime Channels)\x22,1],[\x22ypp_applications\x22,\x22Monetization on YouTube\x22,1],[\x22copyright_contentID\x22,\x22Legal, Copyright \\u0026 Content ID\x22,1],[\x22shorts\x22,\x22YouTube Shorts\x22,1]],[[\x22platform\x22,\x22Platform\x22,[[\x22android\x22,\x22Android\x22],[\x22ios\x22,\x22iOS\x22],[\x22web\x22,\x22Web\x22]]],[\x22User_type\x22,\x22I am a...\x22,[[\x22creator\x22,\x22Creator\x22],[\x22viewer\x22,\x22Viewer\x2