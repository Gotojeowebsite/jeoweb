.tooltip-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
}
.tooltip-wrap::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: #131313;
    color: #fff;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: 12px;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s, visibility 0.2s;
    pointer-events: none;
    z-index: 1000;
}
.tooltip-wrap:hover::after { opacity: 1; visibility: visible; }
.tooltip-fullscreen::after { bottom: calc(100% - 5px); }

