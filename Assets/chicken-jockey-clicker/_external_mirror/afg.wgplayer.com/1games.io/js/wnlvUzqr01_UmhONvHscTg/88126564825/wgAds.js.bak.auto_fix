window['WgAdInterstitial'] = window['WgAdInterstitial'] || class WgAdInterstitial {
  constructor(adUnitPath, outOfPageFormat = 'REWARDED', onReady, onTimeout, onClose, onRewarded, zIndex = 9999, cParams = null, usePpid = true ) {
    this.adUnitPath = adUnitPath;
    this.outOfPageFormat = outOfPageFormat;
    this.onReady = onReady;
    this.onTimeout = onTimeout;
    this.onClose = onClose;
    this.onRewarded = onRewarded;
    this.zIndex = zIndex;
    this.container = null;
    this.adIframe = null;
    this.isReady = false;
    this.showRequested = false;
    this.adShown = false;
    this.timeoutId = null;
    this.promiseResolve = null;
    this.promiseReject = null;
    this.currentFormat = null;
    this.triedFormats = [];
    this.prepareResolve = null;
    this.prepareReject = null;
    this.prepareTimeoutId = null;
    this.cParams = cParams || false;
    this.rewardedEnabled = outOfPageFormat === 'REWARDED';
    this.mobile = false;
    this.usePpid = usePpid;
    
    this._instanceId = Math.random().toString(36).slice(2);
 
    this._isEmbedded = false;
    this._injectedScripts = [];
  }

  
  _cbName(name) {
    return `__wgAdInterstitial_${this._instanceId}_${name}`;
  }

  _deleteCallbacks() {
    delete window[this._cbName('Restore')];
    delete window[this._cbName('OnReady')];
    delete window[this._cbName('OnRewarded')];
    delete window[this._cbName('OnNoFill')];
  }
  

  setRewardedEnabled(enabled) {
    this.rewardedEnabled = enabled;
  }

  isRewarded() {
    return this.currentFormat === 'REWARDED';
  }

  getAlternateFormat() {
    return this.currentFormat === 'REWARDED' ? 'GAME_MANUAL_INTERSTITIAL' : 'REWARDED';
  }

  getPageUrl() {

    if( document.referrer.indexOf( 'y8.com' ) > -1 ){
      return "www.y8.com"
    }

    if( window.location.href.indexOf('wgplayground.com') > -1 ){
      return "wgplayground.com";
    }

    return window.location.href;
    //return "play.wgplayground.com";
    //return new URL(window.location.href).origin;
  }

  isAdReady() {
    return this.isReady;
  }

  isMobile = () => {
    const uaMatch = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini|Mobile|mobile|CriOS/i.test(navigator.userAgent);
    const hasTouch = (
      'ontouchstart' in window ||
      navigator.maxTouchPoints > 0 ||
      navigator.msMaxTouchPoints > 0
    );
    const smallScreen = window.screen.width < 768;
    const mediaQuery = window.matchMedia('(pointer: coarse)').matches;
    const uaData = navigator.userAgentData?.mobile ?? null;
    const signals = [uaMatch, hasTouch, smallScreen, mediaQuery];
    const trueCount = signals.filter(Boolean).length;
    if (uaData !== null) return uaData;
    return trueCount >= 2;
  }

  init(container) {
    if (this.adIframe) return;

    this.mobile = this.isMobile();
    this.container = container;

    try {
      this._isEmbedded = window !== window.top;
    } catch (e) {
      this._isEmbedded = true;
    }

    if (!this.container) {
      console.warn('Container element not provided.');
      return;
    }

    this.currentFormat = this.outOfPageFormat;
    if (!this.rewardedEnabled && this.currentFormat === 'REWARDED') {
      this.currentFormat = 'GAME_MANUAL_INTERSTITIAL';
    }
    this.triedFormats = [];

    this.createAdIframe();
  }

  createAdIframe() {
    if (this.adIframe) {
      this.adIframe.remove();
      this.adIframe = null;
    }

    this.triedFormats.push(this.currentFormat);

    const isRewarded    = this.isRewarded();
    const pageUrl       = this.getPageUrl();
    const mobile        = this.mobile;
    const adUnitPath    = this.adUnitPath;
    const currentFormat = this.currentFormat;
    const usePpid       = this.usePpid;
    const instanceId    = this._instanceId;
    const cParamsJs     = this.cParams ? JSON.stringify(this.cParams) : 'false';

    window[this._cbName('Restore')] = () => {
      const wasShown = this.adShown;
      const resolve  = this.promiseResolve;
      this.restore();
      if (wasShown) {
        if (this.onClose) this.onClose();
        if (resolve) resolve();
      }
    };

    window[this._cbName('OnReady')] = () => {
      this.isReady = true;

      if (this.prepareResolve) {
        this.clearPrepareTimeout();
        this.prepareResolve();
        this.prepareResolve = null;
        this.prepareReject  = null;
      }

      if (this.onReady) this.onReady();

      if (this.showRequested) {
        this.clearTimeout();
        this.adShown = true;
        this.showIframe();
        this.adIframe.contentWindow.showInterstitial();
      }
    };

    window[this._cbName('OnRewarded')] = (payload) => {
      if (this.onRewarded) this.onRewarded(payload);
    };

    window[this._cbName('OnNoFill')] = () => {
      this.tryNextFormat();
    };

    if (this._isEmbedded) {
      this.adIframe = {
        remove:        () => this._cleanupEmbedded(),
        contentWindow: window,
        style:{}
      };

      const inlineCode = `
(function() {
  var AD_UNIT_PATH      = '${adUnitPath}';
  var OUT_OF_PAGE_FORMAT = '${currentFormat}';
  var IS_REWARDED       = ${isRewarded};
  var PAGE_URL          = '${pageUrl}';
  var C_PARAMS          = ${cParamsJs};
  var USEPPID           = ${usePpid};
  var INSTANCE_ID       = '${instanceId}';
  
  // In embedded mode callbacks live on window itself, not window.parent
  function selfCb(name) {
    return window['__wgAdInterstitial_' + INSTANCE_ID + '_' + name];
  }

  window.googletag = window.googletag || { cmd: [] };

  if (USEPPID !== false) {
    var ppid = false;
    try { ppid = window.mcmPublisherProvidedId || window.top.mcmPublisherProvidedId; } catch(e) {}
    if (ppid) {
      googletag.cmd.push(function() { googletag.pubads().setPublisherProvidedId(ppid); });
    }
  }


  function defineAdSlot() {
    var adSlot = googletag.defineOutOfPageSlot(
      AD_UNIT_PATH,
      googletag.enums.OutOfPageFormat[OUT_OF_PAGE_FORMAT]
    );

    if (adSlot) {
      if (C_PARAMS) {
        var entries = new URLSearchParams(C_PARAMS).entries();
        for (var pair of entries) { adSlot['setTargeting'](pair[0], pair[1]); }
      }

      var cat = 'casual_games,${mobile ? 'mobile_games' : 'pc_games'},video_gaming';
      adSlot['setTargeting']('content_cat', cat.split(','));

      adSlot.addService(googletag.pubads());

      googletag.pubads().addEventListener('slotRenderEnded', function(event) {
        if (adSlot === event.slot && event.isEmpty) { selfCb('OnNoFill')(); }
      });

      if (IS_REWARDED) {
        googletag.pubads().addEventListener('rewardedSlotReady', function(e) {
          if (adSlot === e.slot) {
            window.showInterstitial = function() { e.makeRewardedVisible(); };
            selfCb('OnReady')();
          }
        });
        googletag.pubads().addEventListener('rewardedSlotGranted', function(e) {
          if (adSlot === e.slot) {
            selfCb('OnRewarded')({
              type:   e.payload ? e.payload.type   : null,
              amount: e.payload ? e.payload.amount : null
            });
          }
        });
        googletag.pubads().addEventListener('rewardedSlotClosed', function(e) {
          if (adSlot === e.slot) { selfCb('Restore')(); }
        });
      } else {
        googletag.pubads().addEventListener('gameManualInterstitialSlotReady', function(e) {
          if (adSlot === e.slot) {
            window.showInterstitial = function() { e.makeGameManualInterstitialVisible(); };
            selfCb('OnReady')();
          }
        });
        googletag.pubads().addEventListener('gameManualInterstitialSlotClosed', function(e) {
          if (adSlot === e.slot) { selfCb('Restore')(); }
        });
      }

      googletag.pubads().enableSingleRequest();
      googletag.enableServices();
      googletag.display(adSlot);
    } else {
      selfCb('OnNoFill')();
    }
  }

  googletag.cmd.push(function() {
    googletag.pubads().set('page_url', PAGE_URL);    
    defineAdSlot();
  });
})();`;

      if (!document.querySelector('script[src*="securepubads.g.doubleclick.net/tag/js/gpt.js"]')) {
        const gptScript = document.createElement('script');
        gptScript.async = true;
        gptScript.src = 'https://securepubads.g.doubleclick.net/tag/js/gpt.js';
        document.head.appendChild(gptScript);
        this._injectedScripts.push(gptScript);
      }

      const inlineScript = document.createElement('script');
      inlineScript.textContent = inlineCode;
      document.head.appendChild(inlineScript);
      this._injectedScripts.push(inlineScript);

    } else {
      
      const iframe = document.createElement('iframe');

      Object.assign(iframe.style, {
        position:      'absolute',
        top:           '0',
        left:          '0',
        width:         '100%',
        height:        '100%',
        border:        'none',
        zIndex:        this.zIndex,
        visibility:    'hidden',
        pointerEvents: 'none'
      });

      this.container.insertBefore(iframe, this.container.firstChild);
      this.adIframe = iframe;

      const html = `<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>body { margin: 0; }</style>
  <script async src="https://securepubads.g.doubleclick.net/tag/js/gpt.js"></script>
</head>
<body>
  <script>

    var AD_UNIT_PATH       = '${adUnitPath}';
    var OUT_OF_PAGE_FORMAT = '${currentFormat}';
    var IS_REWARDED        = ${isRewarded};
    var PAGE_URL           = '${pageUrl}';
    var C_PARAMS           = ${cParamsJs};
    var USEPPID            = ${usePpid};
    var INSTANCE_ID        = '${instanceId}';
    
    // Callbacks are on the parent window (the page that owns this iframe)
    function parentCb(name) {
      return window.parent['__wgAdInterstitial_' + INSTANCE_ID + '_' + name];
    }

    window.googletag = window.googletag || { cmd: [] };

    if (USEPPID !== false) {
      var ppid = false;
      try { ppid = window.mcmPublisherProvidedId || window.top.mcmPublisherProvidedId; } catch(e) {}
      if (ppid) {
        googletag.cmd.push(function() { googletag.pubads().setPublisherProvidedId(ppid); });
      }
    }

    var adSlot;

    function defineAdSlot() {
      adSlot = googletag.defineOutOfPageSlot(
        AD_UNIT_PATH,
        googletag.enums.OutOfPageFormat[OUT_OF_PAGE_FORMAT]
      );

      if (adSlot) {
        if (C_PARAMS) {
          var entries = new URLSearchParams(C_PARAMS).entries();
          for (var pair of entries) { adSlot['setTargeting'](pair[0], pair[1]); }
        }

        var cat = "casual_games,${mobile ? 'mobile_games' : 'pc_games'},video_gaming";
        adSlot['setTargeting']("content_cat", cat.split(","));

        adSlot.addService(googletag.pubads());

        googletag.pubads().addEventListener('slotRenderEnded', function(event) {
          if (adSlot === event.slot && event.isEmpty) { parentCb('OnNoFill')(); }
        });

        if (IS_REWARDED) {
          googletag.pubads().addEventListener('rewardedSlotReady', function(e) {
            if (adSlot === e.slot) {
              window.showInterstitial = function() { e.makeRewardedVisible(); };
              parentCb('OnReady')();
            }
          });
          googletag.pubads().addEventListener('rewardedSlotGranted', function(e) {
            if (adSlot === e.slot) {
              parentCb('OnRewarded')({
                type:   e.payload ? e.payload.type   : null,
                amount: e.payload ? e.payload.amount : null
              });
            }
          });
          googletag.pubads().addEventListener('rewardedSlotClosed', function(e) {
            if (adSlot === e.slot) { parentCb('Restore')(); }
          });
        } else {
          googletag.pubads().addEventListener('gameManualInterstitialSlotReady', function(e) {
            if (adSlot === e.slot) {
              window.showInterstitial = function() { e.makeGameManualInterstitialVisible(); };
              parentCb('OnReady')();
            }
          });
          googletag.pubads().addEventListener('gameManualInterstitialSlotClosed', function(e) {
            if (adSlot === e.slot) { parentCb('Restore')(); }
          });
        }

        googletag.pubads().enableSingleRequest();
        googletag.enableServices();
        googletag.display(adSlot);

      } else {
        parentCb('OnNoFill')();
      }
    }

    googletag.cmd.push(function() {
      googletag.pubads().set('page_url', PAGE_URL);
      defineAdSlot();
    });
  <\/script>
</body>
</html>`;

      iframe.srcdoc = html;
      iframe.setAttribute("wg-interstitial-frame", "");
    }
  }

  _cleanupEmbedded() {
    this._injectedScripts.forEach(s => s.remove());
    this._injectedScripts = [];
  }

  showIframe() {
    if (this.adIframe) {
      this.adIframe.style.visibility = 'visible';
      this.adIframe.style.pointerEvents = 'auto';
    }
  }

  hideIframe() {
    if (this.adIframe) {
      this.adIframe.style.visibility = 'hidden';
      this.adIframe.style.pointerEvents = 'none';
    }
  }

  tryNextFormat() {
    const alternateFormat = this.getAlternateFormat();
    const canTryAlternate = !this.triedFormats.includes(alternateFormat)
      && (this.rewardedEnabled || alternateFormat !== 'REWARDED');

    if (canTryAlternate) {
      console.log(`No fill for ${this.currentFormat}, trying ${alternateFormat}`);
      this.currentFormat = alternateFormat;
      this.createAdIframe();
    } else {
      console.warn('No fill for any ad format.');

      if (this.prepareReject) {
        this.clearPrepareTimeout();
        this.prepareReject(new Error('No fill'));
        this.prepareResolve = null;
        this.prepareReject = null;
      }

      const rejectFn = this.promiseReject;
      if (this.onTimeout) this.onTimeout();
      this.restore();
      if (rejectFn) rejectFn(new Error('No fill'));
    }
  }

  prepare(timeout = 5000) {
    return new Promise((resolve, reject) => {
      if (this.isReady) {
        resolve();
        return;
      }

      if (!this.adIframe) {
        reject(new Error('Not initialized'));
        return;
      }

      this.prepareResolve = resolve;
      this.prepareReject = reject;

      this.prepareTimeoutId = setTimeout(() => {
        if (!this.isReady) {
          console.warn('Prepare timeout reached.');
          
          const rejectFn = this.prepareReject;
          this.prepareResolve = null;
          this.prepareReject = null;
          if (this.onTimeout) this.onTimeout();
          this.restore();
          if (rejectFn) rejectFn(new Error('Prepare timeout'));
        }
      }, timeout);
    });
  }

  clearPrepareTimeout() {
    if (this.prepareTimeoutId) {
      clearTimeout(this.prepareTimeoutId);
      this.prepareTimeoutId = null;
    }
  }

  show(timeout = 5000) {
    return new Promise((resolve, reject) => {
      
      if (this.showRequested || this.adShown) {
        reject(new Error('Already showing'));
        return;
      }

      if (!this.adIframe) {
        console.warn('Cannot show interstitial: init() not called.');
        if (this.onTimeout) this.onTimeout();
        reject(new Error('Not initialized'));
        return;
      }

      this.promiseResolve = resolve;
      this.promiseReject = reject;

      if (this.isReady && this.adIframe?.contentWindow?.showInterstitial) {
        this.adShown = true;
        this.showIframe();
        this.adIframe.contentWindow.showInterstitial();
      } else {
        this.showRequested = true;
        this.timeoutId = setTimeout(() => {
          if (!this.isReady) {
            console.warn('Interstitial not ready within timeout, restoring.');
            const rejectFn = this.promiseReject;
            if (this.onTimeout) this.onTimeout();
            this.restore();
            if (rejectFn) rejectFn(new Error('Timeout'));
          }
        }, timeout);
      }
    });
  }

  clearTimeout() {
    if (this.timeoutId) {
      clearTimeout(this.timeoutId);
      this.timeoutId = null;
    }
  }

  restore() {
    this.clearTimeout();
    this.clearPrepareTimeout();
    this.isReady = false;
    this.showRequested = false;
    this.adShown = false;
    this.promiseResolve = null;
    this.promiseReject = null;
    this.prepareResolve = null;
    this.prepareReject = null;
    this.triedFormats = [];
    this.currentFormat = null;  
    this._isEmbedded = false;

    this._deleteCallbacks();

    if (this.adIframe) {
      this.adIframe.remove();
      this.adIframe = null;
    }
  }
}//# sourceURL=/_/a/
