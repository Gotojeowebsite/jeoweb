{
  "name": "jeoweb",
  "version": "1.0.0",
  "description": "Jeoweb - Games & Proxy",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "astro dev",
    "build": "astro build && node scripts/link-assets-into-dist.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "covers:fix": "python3 fix_game_covers.py --apply",
    "covers:audit": "python3 fix_game_covers.py --check-only",
    "game:import-full": "python3 import_game_from_url.py",
    "flash:import": "pwsh -NoLogo -NoProfile -File ./import-flash.ps1",
    "flash:fetch-images": "pwsh -NoLogo -NoProfile -File ./import-flash.ps1 --fetch-images",
    "grab": "node scripts/grab-game.js",
    "game:download": "node scripts/download-game.js",
    "game:add": "node scripts/add-game.js",
    "game:scan": "node scan.js",
    "health:static": "node scripts/static-health-scan.js",
    "health:build": "node scripts/build-game-health.js",
    "health:refresh": "node scan.js && node scripts/static-health-scan.js && node scripts/build-game-health.js",
    "health:recheck": "node scripts/recheck-healthy.js",
    "health:flapping": "node scripts/build-game-health.js --flapping",
    "offline:manifest": "node scripts/build-offline-manifest.js --all",
    "offline:verify": "node scripts/verify-offline-manifest.js",
    "offline:localize": "node scripts/localize-all-games.js --apply",
    "recover": "node scripts/recover-game.js",
    "recover:all": "node scripts/recover-all-broken.js",
    "recover:dry": "node scripts/recover-game.js --dry-run --verbose",
    "recover:rollback": "node scripts/recovery/rollback.js",
    "game:heal": "node scripts/maintenance-toggle.js heal",
    "game:break": "node scripts/maintenance-toggle.js break",
    "game:maintenance:list": "node scripts/maintenance-toggle.js list",
    "game:fix-recents": "node scripts/fix-broken-recents.js --apply",
    "game:fix-recents:dry": "node scripts/fix-broken-recents.js",
    "game:cover": "node scripts/generate-cover.js",
    "game:cover:fill": "node scripts/generate-cover.js --all-missing",
    "game:offline:audit": "node scripts/audit-offline-readiness.js",
    "game:offline:refresh": "node scan.js && node scripts/audit-offline-readiness.js",
    "media:init": "git lfs install && node scripts/install-hooks.js",
    "media:ingest": "node scripts/media-ingest.js",
    "media:validate": "node scripts/media-validate.js",
    "media:hooks": "node scripts/install-hooks.js"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/preact": "^5.1.3",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@nebula-services/bare-server-node": "^2.0.4",
    "@types/node": "^25.8.0",
    "astro": "^6.3.3",
    "jsonrepair": "^3.13.3",
    "minisearch": "^7.2.0",
    "node-fetch": "^3.3.2",
    "playwright": "^1.59.1",
    "preact": "^10.29.1",
    "puppeteer": "^24.40.0",
    "typescript": "^6.0.3"
  }
}
